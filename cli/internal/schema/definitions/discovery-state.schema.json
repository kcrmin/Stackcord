{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stackcord.invalid/schemas/discovery-state.schema.json",
  "type": "object",
  "required": [
    "schema_version",
    "plan",
    "decision_questions"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "plan": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "#/$defs/discovery"
        }
      ]
    },
    "decision_questions": {
      "type": "object",
      "propertyNames": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
      },
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(\\.[a-z][a-z0-9-]*)+$"
    },
    "discovery": {
      "type": "object",
      "required": [
        "scope_ready",
        "sections",
        "questions"
      ],
      "properties": {
        "scope_ready": {
          "type": "boolean"
        },
        "sections": {
          "type": "array",
          "minItems": 1,
          "maxItems": 100,
          "items": {
            "$ref": "#/$defs/section"
          }
        },
        "questions": {
          "type": "array",
          "maxItems": 1000,
          "items": {
            "$ref": "#/$defs/question_plan"
          }
        }
      },
      "additionalProperties": false
    },
    "section": {
      "type": "object",
      "required": [
        "id",
        "title",
        "status",
        "estimated_remaining"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "planned",
            "active",
            "complete"
          ]
        },
        "estimated_remaining": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        }
      },
      "additionalProperties": false
    },
    "option": {
      "type": "object",
      "required": [
        "id",
        "label"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "label": {
          "type": "string",
          "minLength": 1
        }
      },
      "additionalProperties": false
    },
    "question_plan": {
      "type": "object",
      "required": [
        "question_id",
        "section_id",
        "requires_explicit_answer",
        "blocking"
      ],
      "properties": {
        "question_id": {
          "$ref": "#/$defs/id"
        },
        "section_id": {
          "$ref": "#/$defs/id"
        },
        "options": {
          "type": "array",
          "minItems": 2,
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/option"
          }
        },
        "recommended_option_id": {
          "type": "string",
          "minLength": 1
        },
        "requires_explicit_answer": {
          "type": "boolean"
        },
        "blocking": {
          "type": "boolean"
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/id"
          }
        }
      },
      "additionalProperties": false
    }
  }
}
